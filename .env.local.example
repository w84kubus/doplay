# Skopiuj do .env.local i uzupełnij wartościami z konsoli Firebase.
# .env.local jest w .gitignore — nigdy nie commituj prawdziwych kluczy.

# --- Publiczne (klient) — Project settings → General → Your apps → SDK config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- TYLKO SERWER — nigdy z prefiksem NEXT_PUBLIC_ ---
# Project settings → Service accounts → Generate new private key → cały JSON zakodowany base64:
#   base64 -i sciezka/do/klucza.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=

# Sekret harmonogramu Vercela (cron sprzątający wygasłe pokoje).
# Wygeneruj: openssl rand -hex 32
# Ustaw TĘ SAMĄ wartość w Vercel → Settings → Environment Variables.
# Bez niej trasa /api/cron/cleanup jest zamknięta (odpowiada 401).
CRON_SECRET=
