# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serwist: service worker generowany z src/sw.ts podczas `next build`
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# Referencje graficzne (11 MB zrzutów cudzego produktu) — trzymamy lokalnie
/design/refs/
# Skille narzędziowe (7,9 MB paczek third-party)
/.claude/skills/
# Źródła pakietów ikon (PNG-i) — do repo idą przetworzone WebP z public/
/emoji-pack/
/emotki-gry/
# Surowe pliki z generatora (15 MB JPEG-ów na zielonym tle). Odtwarzalne z promptów
# w assets/PROMPTS.md; do repo idą wycinanki z public/assets/
/assets/zrodla/
# Zrzuty ekranu wrzucane do rootu na potrzeby rozmowy (10 MB) — nie należą do repo
/*.jpg
/domowka-icon/

# Ślady po narzędziu Playwright MCP (zrzuty, logi konsoli) - nie należą do repo.
.playwright-mcp/
